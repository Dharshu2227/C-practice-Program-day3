#include <stdio.h>
int countDigit(int num, int digit)
{
    if (num == 0)
        return 0;

    if (num % 10 == digit)
        return 1 + countDigit(num / 10, digit);
    else
        return countDigit(num / 10, digit);
}
int main()
{
    int num, digit, count;
    printf("Enter a positive integer: ");
    scanf("%d", &num);
    printf("Enter the digit to count: ");
    scanf("%d", &digit);
    count = countDigit(num, digit);
    printf("Digit %d occurs %d time(s) in %d.\n", digit, count, num);
    return 0;
}

